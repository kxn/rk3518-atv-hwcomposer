cc_binary {
    name: "rk_hwc_sync_audit",
    vendor: true,
    compile_multilib: "64",
    srcs: ["audit-tests/sync_audit.cpp", "rockchip/common/drmfence.cpp"],
    local_include_dirs: ["include"],
    shared_libs: ["libutils", "libsync", "liblog", "libcutils"],
    cflags: ["-Wall", "-Werror", "-fno-access-control"],
}
